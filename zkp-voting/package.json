{
  "license": "ISC",
  "scripts": {
    "test": "anchor test",
    "test:integration": "env ANCHOR_PROVIDER_URL=http://127.0.0.1:8899 ANCHOR_WALLET=$HOME/.config/solana/id.json ts-mocha -p ./tsconfig.json -t 1000000 tests/zkp-voting.ts",
    "prepare:test-proof": "node client/make_inputs.mjs && sunspot prove ../circuits/target/voting_circuit.json ../circuits/target/voting_circuit.gz ../circuits/target/voting_circuit.ccs ../circuits/target/voting_circuit.pk",
    "prepare:tally-proof": "node client/make_tally_inputs.mjs && sunspot prove ../circuits/target/tally_circuit.json ../circuits/target/tally_circuit.gz ../circuits/target/tally_circuit.ccs ../circuits/target/tally_circuit.pk",
    "test:compressed": "npm run prepare:test-proof && env ANCHOR_PROVIDER_URL=http://127.0.0.1:8899 ANCHOR_WALLET=$HOME/.config/solana/id.json ts-mocha -p ./tsconfig.json -t 1000000 tests/compressed-ballot.ts",
    "test:instructions": "env ANCHOR_PROVIDER_URL=http://127.0.0.1:8899 ANCHOR_WALLET=$HOME/.config/solana/id.json ts-mocha -p ./tsconfig.json -t 1000000 tests/instructions.ts",
    "test:tally": "npm run prepare:test-proof && npm run prepare:tally-proof && env ANCHOR_PROVIDER_URL=http://127.0.0.1:8899 ANCHOR_WALLET=$HOME/.config/solana/id.json ts-mocha -p ./tsconfig.json -t 1000000 tests/tally.ts",
    "test:light": "npm run test:integration && npm run test:compressed && npm run test:instructions && npm run test:pda",
    "test:sunspot": "env ANCHOR_PROVIDER_URL=http://127.0.0.1:8899 ANCHOR_WALLET=$HOME/.config/solana/id.json ts-mocha -p ./tsconfig.json -t 1000000 tests/sunspot.ts",
    "test:pda": "ts-mocha -p ./tsconfig.json -t 1000000 tests/adversarial.ts",
    "test:ts": "npm run test:light",
    "test:unit": "npm run test:pda",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  },
  "devDependencies": {
    "@lightprotocol/stateless.js": "0.23.3",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
