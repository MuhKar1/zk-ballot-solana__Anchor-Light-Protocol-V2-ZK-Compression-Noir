# Copy to .env.local and adjust for your environment.

# Solana RPC (defaults to the Light test-validator started by the runbook).
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899

# Light Protocol V2 services (defaults to the local test-validator ports).
NEXT_PUBLIC_LIGHT_INDEXER_URL=http://127.0.0.1:8784
NEXT_PUBLIC_LIGHT_PROVER_URL=http://127.0.0.1:3001

# The on-chain program + pinned Sunspot verifier programs (devnet IDs).
NEXT_PUBLIC_PROGRAM_ID=4uiu9QzRVZYdLdxCmADj6cQwFCrNufDCgU7NtsvQJWYA
NEXT_PUBLIC_VOTING_VERIFIER_ID=9jjgdh8kXLqZEkAGYjXTXsXGQeGALJ6YYKn5Gz3KXgYj
NEXT_PUBLIC_TALLY_VERIFIER_ID=AuSPaahFzAViTokdyhc6fYNe1gELiHRksbExo2YNptav
NEXT_PUBLIC_ADDRESS_TREE_V2=amt2kaJA14v3urZbZvnc5v2np8jqvc4Z8zDep5wbtzx

# --- Prover selection ---
# "node" (default) delegates proving to the local /api/prove route (nargo+sunspot).
# "wasm" uses the on-device gnark prover (app/prisms/prover) — requires building
# prover.wasm and staging the circuit artifacts in public/proving/.
NEXT_PUBLIC_PROVER=node

# --- DEV-ONLY proving service (see src/lib/proving/README note) ---
# Absolute path to the repo circuits dir, used by /api/prove to run
# `nargo execute` + `sunspot prove` locally. Only used server-side.
SUNSPOT_CIRCUITS_DIR=/absolute/path/to/ZKP-Voting-System/circuits

# --- Relayer wallet (server-only, never NEXT_PUBLIC) ---
# The relayer signs + pays every cast_vote transaction so the voter's public key
# never appears on-chain. Paste a 64-byte ed25519 secret key as a JSON array and
# fund the corresponding address (e.g. `solana airdrop 2 <pubkey>`).
# RELAYER_SECRET_KEY=[0,0,0, ... 64 numbers ...]
